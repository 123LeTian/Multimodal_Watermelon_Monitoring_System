# Fused dataset metadata can be tracked, but images are too large for normal git.
dataset_fused/images/

# Local handoff packages for Release or cloud drive upload.
handoff_assets/
deliverables/

# Generated single-sample files; keep only its documentation
single_sample/**
!single_sample/README.md

# External datasets may have separate redistribution licenses
data_external/

# Project source PDF may contain personal contact information
docs/南开大学_基于多模态感知与云端机器学习的大棚西瓜生长监测模型的研究.pdf

