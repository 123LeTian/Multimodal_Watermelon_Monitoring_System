# Trained weights and generated training artifacts
*.pth
checkpoints/**
!checkpoints/.gitkeep
!checkpoints/final_weak_supervised_baseline/
!checkpoints/final_weak_supervised_baseline/effective_config.yaml
outputs/**
!outputs/.gitkeep
!outputs/final_weak_supervised_baseline/
